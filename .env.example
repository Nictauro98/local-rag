# MinIO (local S3-compatible storage)
RAG_MINIO_ENDPOINT=minio:9000
RAG_MINIO_ACCESS_KEY=minioadmin
RAG_MINIO_SECRET_KEY=minioadmin
RAG_MINIO_BUCKET=documents
RAG_MINIO_SECURE=false

# Qdrant vector store
RAG_QDRANT_URL=http://qdrant:6333
RAG_QDRANT_COLLECTION=chunks

# Ollama (local LLM + embedding)
RAG_OLLAMA_URL=http://ollama:11434
RAG_EMBED_MODEL=nomic-embed-text
RAG_LLM_MODEL=llama3.2

# Redis (arq broker + result backend)
RAG_REDIS_URL=redis://redis:6379

# Ingestion settings
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Query settings
RAG_TOP_K=5

# Adapter selection (local | aws) — swap to 'aws' when migrating
RAG_STORAGE_BACKEND=local
RAG_EMBEDDER_BACKEND=local
